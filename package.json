{
  "name": "agent-telemetry",
  "version": "0.1.0",
  "description": "Capture Claude Code's OpenTelemetry output on your own machine, normalize it into SQLite, and query it from inside Claude Code over MCP.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fatherjake/telemetry.git"
  },
  "bin": {
    "telemetry": "bin/telemetry.js",
    "agent-telemetry": "bin/telemetry.js"
  },
  "files": [
    "bin",
    "dist",
    "skills",
    "README.md",
    "PRIVACY.md"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "prepare": "husky",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test test/*.test.js"
  },
  "keywords": [
    "claude",
    "claude-code",
    "opentelemetry",
    "otlp",
    "telemetry",
    "mcp",
    "sqlite"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.68.0"
  },
  "lint-staged": {
    "*.{ts,js,mjs,json,md,yml}": "prettier --check"
  }
}
