# Collected telemetry lives in ~/.telemetry, never in the checkout.
# Nothing here should ever produce data files, but just in case:
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.jsonl

# Secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*credentials*.json
*service-account*.json

# Node
node_modules/
dist/
# generated from .claude/skills by the build, for packaging. Anchored, or it
# would also swallow .claude/skills itself.
/skills/
*.tgz
*.tsbuildinfo
.npm/

# Editor / OS noise
.DS_Store
*.swp
*.log
.idea/
.vscode/
